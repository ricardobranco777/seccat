CC     ?= cc
CFLAGS ?= -O2 -Wall -Wextra
CLANG_FORMAT ?= clang-format
SOURCES = secprobe.c seccomp-compile.c

secprobe: secprobe.c syscalls.h
	$(CC) $(CFLAGS) -o $@ secprobe.c

# Static, for running in a scratch image.
static: secprobe.c syscalls.h
	$(CC) $(CFLAGS) -static -o secprobe secprobe.c

# Compiles rules to BPF for setpriv; needs libseccomp's headers.
seccomp-compile: seccomp-compile.c
	$(CC) $(CFLAGS) -o $@ seccomp-compile.c -lseccomp

# Checks secprobe against real filters, see test.sh.
test: secprobe seccomp-compile
	./test.sh

# The syscall and errno tables come from the target's own headers. Syscall
# numbers stay symbolic, as some arches define them as expressions; secprobe.c
# sorts the table. Uppercase names (__NR_SYSCALL_BASE) and the generic
# __NR_syscalls and __NR_arch_specific_syscall are not syscalls.
syscalls.h: Makefile
	{ \
	echo '/* Generated by make; DO NOT EDIT. */'; \
	echo; \
	echo 'static struct syscall_entry syscall_table[] = {'; \
	echo '#include <sys/syscall.h>' | $(CC) $(CPPFLAGS) -E -dM - | \
		awk '$$1 == "#define" && $$2 ~ /^__NR_[a-z0-9_]+$$/ && \
		     $$2 != "__NR_syscalls" && $$2 != "__NR_arch_specific_syscall" \
		     { printf "\t{%s, \"%s\"},\n", $$2, substr($$2, 6) }' | sort; \
	echo '};'; \
	echo; \
	echo 'static const char *const errno_names[] = {'; \
	echo '#include <errno.h>' | $(CC) $(CPPFLAGS) -E -dM - | \
		awk '$$1 == "#define" && $$2 ~ /^E[A-Z0-9]+$$/ && $$3 ~ /^[0-9]+$$/ \
		     { printf "\t[%s] = \"%s\",\n", $$3, $$2 }' | sort -t'[' -k2 -n; \
	echo '};'; \
	} > $@.tmp && mv $@.tmp $@

# For development and CI: the format must be clang-format's and the build must
# have no warnings. -Werror is not in CFLAGS, so a newer compiler's new warnings
# don't break anyone's build.
check:
	$(CLANG_FORMAT) --dry-run -Werror $(SOURCES)
	$(MAKE) -B secprobe seccomp-compile CFLAGS="-O2 -Wall -Wextra -Werror"

fmt:
	$(CLANG_FORMAT) -i $(SOURCES)

clean:
	rm -f secprobe syscalls.h seccomp-compile

.PHONY: static test check fmt clean
